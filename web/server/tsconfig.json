{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "src",
    "../src/utils/shareLink.ts",
    "../src/data/types.ts",
    "../src/data/health/scorer.ts",
    "../src/data/health/compliance.ts",
    "../src/data/health/longTail.ts",
    "../src/data/mock/seedData.ts",
    "../src/styles/tokens.ts"
  ]
}
