# LinJi·灵集 生产环境变量模板
# 用法：cp .env.production.example .env 后逐项填写；
#       Docker Compose 自动读取同目录 .env；PM2/宝塔 Node 项目见部署文档（不会自动加载，需 PM2 env 或 ecosystem 配置）

# JWT 密钥（必须修改为长随机串！生成：openssl rand -base64 48）
# compose 用 :? 语法强制校验，不设置会拒绝启动
JWT_SECRET=change-me-in-production

# 运行模式（必须 production：托管 dist + 收紧日志）
NODE_ENV=production

# 服务端口（宝塔安全组 / 防火墙需放行；Nginx 反代则只需本地端口）
PORT=8787

# 采集抓取代理：海外服务器留空（直连抖音/小红书/YouTube）
# 仅被墙网络调试需要；注意代理只覆盖海外域名，国内平台自动直连
COLLECT_PROXY=

# 抖音/TikTok 解析服务（Douyin_TikTok_Download_API sidecar）
# Docker compose 部署时默认 http://douyin-api:80；独立部署填 sidecar 地址；
# 留空则走分享页/iteminfo 降级链（拿不到会如实告知）
DOUYIN_API_URL=http://douyin-api:80

# yt-dlp 路径（Instagram 解析；Docker 镜像已装，PM2 部署需自装）
YTDLP_PATH=yt-dlp

# 上传体积上限（字节）：图片 15MB / 视频 200MB
# ⚠️ Nginx 反代需同步设置 client_max_body_size 210m，否则大视频被挡
MAX_IMAGE_BYTES=15728640
MAX_VIDEO_BYTES=209715200

# 单次采集下载单张媒体的上限
MAX_COLLECT_MEDIA_BYTES=20971520

# 抓取超时（毫秒）——多图采集可能较慢，别调太小
FETCH_TIMEOUT_MS=15000
